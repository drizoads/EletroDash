{
  "name": "eletrodash",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de gestão do EletroPay para donos de posto",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run format:check && vite build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  }
}
